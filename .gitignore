# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/
/build
/captures
.externalNativeBuild
.cxx/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Proguard/R8 mapping output (deobfuscates release builds)
proguardTools/
mapping.txt

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/*

# Keystore files — NEVER commit signing keys
*.jks
*.keystore
keystore.properties

# Local-only working files (keystore, notes, release assets)
files/*

# Google Services (contains project config; keep out unless intentionally public)
# google-services.json

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint/reports/

# OS files
.DS_Store
Thumbs.db
