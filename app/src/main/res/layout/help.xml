<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/help_layout_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/space_triple"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/help_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="invisible">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:indeterminate="true"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/help_progress"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_triple">

        <TextView
            android:id="@+id/help_text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/space_default"
            android:paddingStart="@dimen/space_default"
            android:paddingTop="@dimen/space_small"
            android:text="@string/help_title"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_extra_big" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_default">

            <TextView
                android:id="@+id/help_text_faq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/space_default"
                android:paddingStart="@dimen/space_default"
                android:text="@string/help_faq_subtitle"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_default" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/help_text_faq"
                android:background="@color/colorPrimary" />

        </RelativeLayout>

        <android.support.v7.widget.RecyclerView
            android:id="@+id/help_recyclerview_faq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_default">

            <TextView
                android:id="@+id/help_text_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingEnd="@dimen/space_default"
                android:paddingStart="@dimen/space_default"
                android:text="@string/help_about_subtitle"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_default" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/help_text_about"
                android:background="@color/colorPrimary" />

        </RelativeLayout>

        <LinearLayout
            style="@style/settingEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="actionShowChangelog">

            <TextView
                android:id="@+id/help_text_version_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_tiny"
                android:text="@string/help_about_version_label"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/help_text_version_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_small" />

        </LinearLayout>

        <LinearLayout
            style="@style/settingEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/help_text_team_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_tiny"
                android:text="@string/help_about_team_label"
                android:textSize="@dimen/text_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:text="@string/help_about_team_value"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_small" />

        </LinearLayout>

        <LinearLayout
            style="@style/settingEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="actionSendEmailDeveloper">

            <TextView
                android:id="@+id/help_text_email_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_tiny"
                android:text="@string/help_about_email_label"
                android:textSize="@dimen/text_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:text="@string/help_about_email_address"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_small" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>