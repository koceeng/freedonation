<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_mini"
    android:orientation="vertical" >

    <FrameLayout
        android:id="@+id/setting_alarm_item_button"
        android:layout_width="@dimen/height_mini"
        android:layout_height="@dimen/height_mini"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/close"
            android:tint="@color/colorDanger"
            android:contentDescription="@null"/>

    </FrameLayout>

    <TextView
        android:id="@+id/setting_alarm_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/setting_alarm_item_button"
        android:layout_marginStart="@dimen/space_default"
        android:layout_gravity="center_vertical"
        android:textSize="@dimen/text_default"/>

</RelativeLayout>