<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark">

    <FrameLayout
        android:id="@+id/impression_button_next"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_small"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="@color/colorAccentDark"
        android:onClick="actionImpressionNext">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables,UselessParent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorThemeWhite"
                android:text="@string/next_uppercase" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="@dimen/space_small"
                android:src="@drawable/next"
                android:contentDescription="@null"/>

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/impression_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_above="@id/impression_button_next"
        android:layout_centerHorizontal="true"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:indeterminate="true"/>

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/impression_button_next"
        android:layout_centerHorizontal="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_double"
            android:paddingStart="@dimen/space_default"
            android:paddingEnd="@dimen/space_default"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="@dimen/space_double"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/icon_vector"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_double"
                android:gravity="center_horizontal"
                android:textColor="@color/colorThemeWhite"
                android:textSize="@dimen/text_large"
                android:text="@string/impression_title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_default"
                android:gravity="center_horizontal"
                android:textColor="@color/colorThemeWhite"
                android:textSize="@dimen/text_default"
                android:text="@string/impression_text_1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_default"
                android:gravity="center_horizontal"
                android:textColor="@color/colorThemeWhite"
                android:textSize="@dimen/text_default"
                android:text="@string/impression_text_2"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_default"
                android:gravity="center_horizontal"
                android:textColor="@color/colorThemeWhite"
                android:textSize="@dimen/text_default"
                android:text="@string/impression_text_3"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="@color/colorThemeWhite"
                android:textSize="@dimen/text_default"
                android:text="@string/impression_text_4"/>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>