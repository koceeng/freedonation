<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/space_default"
    android:gravity="bottom"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/setting_language_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_tiny"
        android:paddingTop="@dimen/space_tiny">

        <RadioButton
            android:id="@+id/setting_language_radio_in"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_mini"
            android:layout_weight="1"
            android:text="@string/PREFERENCE_LANGUAGE_IN_LABEL" />

        <RadioButton
            android:id="@+id/setting_language_radio_en"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_mini"
            android:layout_weight="1"
            android:text="@string/PREFERENCE_LANGUAGE_EN_LABEL" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/setting_language_button_cancel"
            style="@style/AppButtonBorderlessColored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/setting_language_button_save"
            style="@style/AppButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/save" />
    </LinearLayout>

</LinearLayout>