<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="@dimen/space_default"
    android:paddingStart="@dimen/space_default">

    <TextView
        android:id="@+id/bank_account_item_text_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/bank_account_item_text_bank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/bank_account_item_text_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/bank_account_item_text_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>