<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_default"
    android:orientation="vertical">

    <View
        android:id="@+id/bank_account_item_layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_default"
        android:layout_marginEnd="@dimen/space_default"
        android:background="@color/colorThemeGrayDark" />

    <TextView
        android:id="@+id/bank_account_item_text_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_mini"
        android:paddingBottom="@dimen/space_mini"
        android:paddingStart="@dimen/space_default"
        android:paddingEnd="@dimen/space_default"
        android:background="@color/colorDivider"
        android:textColor="@color/colorThemeWhite"
        android:visibility="gone"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/bank_account_item_button_copy"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:src="@drawable/copy"
                android:contentDescription="@null"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/bank_account_item_text_bank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/bank_account_item_button_copy"
            android:layout_marginTop="@dimen/space_default"
            android:layout_marginBottom="@dimen/space_tiny"
            android:layout_marginStart="@dimen/space_default"
            android:paddingStart="@dimen/space_default"
            android:paddingEnd="@dimen/space_default"/>

        <TextView
            android:id="@+id/bank_account_item_text_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/bank_account_item_text_bank"
            android:layout_toStartOf="@id/bank_account_item_button_copy"
            android:layout_marginBottom="@dimen/space_tiny"
            android:layout_marginStart="@dimen/space_default"
            android:paddingStart="@dimen/space_default"
            android:paddingEnd="@dimen/space_default"/>

        <TextView
            android:id="@+id/bank_account_item_text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/bank_account_item_text_number"
            android:layout_toStartOf="@id/bank_account_item_button_copy"
            android:layout_marginBottom="@dimen/space_tiny"
            android:layout_marginStart="@dimen/space_default"
            android:paddingStart="@dimen/space_default"
            android:paddingEnd="@dimen/space_default"/>

    </RelativeLayout>

</LinearLayout>